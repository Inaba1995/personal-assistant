// Prisma schema: SQLite (запуск без внешней инфраструктуры).
// Все сущности, кроме User и RefreshToken, содержат userId + индекс по userId,
// каскадное удаление при удалении пользователя.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum DocumentType {
  NOTE
  LETTER
  DOC
}

enum AvitoStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CommentStatus {
  NEW
  ANSWERED
}

enum ContractorStatus {
  FOUND
  CONTACTED
  SHORTLISTED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  refreshTokens RefreshToken[]
  tasks         Task[]
  deadlines     Deadline[]
  documents     Document[]
  spreadsheets  Spreadsheet[]
  presentations Presentation[]
  aiRequests    AiRequest[]
  searchResults SearchResult[]
  videoSummaries VideoSummary[]
  avitoListings AvitoListing[]
  comments      Comment[]
  contractors   Contractor[]
  settings      Settings?
}

// Ротация refresh-токенов: хранится только SHA-256 хеш токена.
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Task {
  id          String       @id @default(cuid())
  userId      String
  title       String
  description String       @default("")
  status      TaskStatus   @default(BACKLOG)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  tags        Json         @default("[]")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deadlines Deadline[]

  @@index([userId])
}

model Deadline {
  id         String    @id @default(cuid())
  userId     String
  taskId     String?
  title      String
  date       DateTime
  remindedAt DateTime?

  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Document {
  id        String       @id @default(cuid())
  userId    String
  title     String
  content   String       @default("")
  type      DocumentType @default(NOTE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Spreadsheet {
  id        String   @id @default(cuid())
  userId    String
  name      String
  columns   Json     @default("[]")
  rows      Json     @default("[]")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Presentation {
  id        String   @id @default(cuid())
  userId    String
  title     String
  slides    Json     @default("[]")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AiRequest {
  id         String   @id @default(cuid())
  userId     String
  prompt     String
  response   String
  model      String
  tokensUsed Int?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SearchResult {
  id        String   @id @default(cuid())
  userId    String
  query     String
  summary   String
  sources   Json     @default("[]")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VideoSummary {
  id         String   @id @default(cuid())
  userId     String
  url        String   @default("")
  summary    String
  timestamps Json     @default("[]")
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AvitoListing {
  id          String      @id @default(cuid())
  userId      String
  title       String
  description String      @default("")
  price       Float       @default(0)
  status      AvitoStatus @default(DRAFT)
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Comment {
  id        String        @id @default(cuid())
  userId    String
  platform  String
  author    String
  text      String
  reply     String        @default("")
  status    CommentStatus @default(NEW)
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Contractor {
  id        String           @id @default(cuid())
  userId    String
  name      String
  contact   String           @default("")
  skills    Json             @default("[]")
  status    ContractorStatus @default(FOUND)
  notes     String           @default("")
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Settings {
  id             String   @id @default(cuid())
  userId         String   @unique
  workHoursStart String   @default("09:00")
  workHoursEnd   String   @default("18:00")
  timezone       String   @default("Europe/Moscow")
  aiModel        String   @default("gpt-4o-mini")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
