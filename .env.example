# Скопируйте этот файл в .env и заполните значения.
# Скрипт `npm run dev` создаст .env автоматически, если его нет.

# --- База данных (SQLite, файл относительно prisma/schema.prisma) ---
DATABASE_URL="file:./dev.db"

# --- JWT (смените оба значения перед продакшеном: openssl rand -hex 32) ---
JWT_SECRET="change-me-access-token-secret-long-random"
JWT_REFRESH_SECRET="change-me-refresh-token-secret-long-random"

# --- OpenAI (ОПЦИОНАЛЬНО) ---
# Если пусто — разделы AI, Search и Video Summary работают в режиме заглушки.
# Ключ хранится ТОЛЬКО здесь, в БД и на фронт не передаётся.
OPENAI_API_KEY=""

# --- Сервер ---
PORT=4000

# --- CORS: origin фронта (в dev — Vite dev server) ---
CORS_ORIGIN="http://localhost:5173"
